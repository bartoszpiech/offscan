{
  "sourceLanguage": "en",
  "strings": {
    "%@, %lld pages": {
      "comment": "Accessibility value of a document card: relative date, page count",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, %#@pages@"
          },
          "substitutions": {
            "pages": {
              "argNum": 2,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg page"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg pages"
                    }
                  }
                }
              }
            }
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, %#@pages@"
          },
          "substitutions": {
            "pages": {
              "argNum": 2,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "few": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg strony"
                    }
                  },
                  "many": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg stron"
                    }
                  },
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg strona"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg strony"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "%@, page %lld": {
      "comment": "Name of one page of a multi-page file (TIFF or PDF), e.g. in the list of items that couldn't be imported: 'fax.tiff, page 2'",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, page %2$lld"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, strona %2$lld"
          }
        }
      }
    },
    "%lld documents": {
      "comment": "Number of documents in a folder",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld document"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld documents"
                }
              }
            }
          }
        },
        "pl": {
          "variations": {
            "plural": {
              "few": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld dokumenty"
                }
              },
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld dokumentów"
                }
              },
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld dokument"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld dokumentu"
                }
              }
            }
          }
        }
      }
    },
    "%lld of %lld pages could not be saved.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się zapisać %1$lld z %2$lld stron."
          }
        }
      }
    },
    "%lld percent from left, %lld percent from top": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld procent od lewej, %2$lld procent od góry"
          }
        }
      }
    },
    "%lld percent from the left, %lld percent from the top, %lld percent of the page width": {
      "comment": "Signature position for VoiceOver",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld procent od lewej, %2$lld procent od góry, %3$lld procent szerokości strony"
          }
        }
      }
    },
    "%lld percent wide, %lld percent high": {
      "comment": "Crop area size for VoiceOver",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Szerokość %1$lld procent, wysokość %2$lld procent"
          }
        }
      }
    },
    "%lld Selected": {
      "comment": "Library title in Select mode",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld Selected"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaznaczono: %lld"
          }
        }
      }
    },
    "A4": {
      "comment": "PDF page size",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "A4"
          }
        }
      }
    },
    "About": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Informacje"
          }
        }
      }
    },
    "Add": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj"
          }
        }
      }
    },
