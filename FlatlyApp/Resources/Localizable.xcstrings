    "It will be moved to Recently Deleted, where you can restore it for 30 days.": {
      "comment": "Delete confirmation message for one document",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trafi do folderu Ostatnio usunięte, skąd przez 30 dni możesz go przywrócić."
          }
        }
      }
    },
    "They will be moved to Recently Deleted, where you can restore them for 30 days.": {
      "comment": "Delete confirmation message for several documents",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trafią do folderu Ostatnio usunięte, skąd przez 30 dni możesz je przywrócić."
          }
        }
      }
    },
    "Recently Deleted": {
      "comment": "Title of the folder-like list of deleted documents, kept for 30 days",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ostatnio usunięte"
          }
        }
      }
    },
    "Documents are erased permanently 30 days after you delete them.": {
      "comment": "Recently Deleted: list header",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Po 30 dniach dokumenty są stąd trwale usuwane."
