      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj strony"
          }
        }
      }
    },
    "Applied to new scans and imports. You can change it for each page later.": {
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stosowany do nowych skanów i importów. Później możesz go zmienić dla każdej strony."
